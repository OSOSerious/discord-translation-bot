# Copy to .env and fill in. Never commit the real .env.

# Required — bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN=

# Backend A — self-hosted LibreTranslate (fully local/private)
# macOS note: port 5000 is taken by AirPlay Receiver, use e.g. 5100
#   docker run -d --name libretranslate -p 5100:5000 libretranslate/libretranslate
LIBRETRANSLATE_URL=http://localhost:5100
LIBRETRANSLATE_API_KEY=

# Backend B — DeepL (free tier keys end in :fx). Takes precedence when set.
# DEEPL_API_KEY=
